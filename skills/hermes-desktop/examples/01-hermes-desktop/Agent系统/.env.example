# Hermes Desktop 环境变量样例（复制为 .env 后填写，.env 已被 .gitignore 忽略）
# 也可用 HERMES_HOME/config.yaml 配置 provider（见 hermes-llms-full.txt）。

# 必填：Hermes API Key（或用 config.yaml 配置）
HERMES_API_KEY=sk-xxx

# 可选：模型与 base_url（默认 deepseek-chat；按你的 provider 改）
HERMES_MODEL=deepseek-chat
HERMES_BASE_URL=

# 可选：冻结态数据目录（EXE 运行时默认 <exe>/hermes_data，一般无需改）
# HERMES_HOME=
